{
	"exec": [
		"rm -fv _build/upload/src/addons/{addon_id}/composer.json",
		"rm -fv _build/upload/src/addons/{addon_id}/composer.lock",
		"rm -fv _build/upload/src/addons/{addon_id}/phpunit.xml",
		"rm -fv _build/upload/src/addons/{addon_id}/phpstan.neon",
		"rm -fv _build/upload/src/addons/{addon_id}/phpstan-tests.neon",
		"rm -rfv _build/upload/src/addons/{addon_id}/tests",
		"rm -rfv _build/upload/src/addons/{addon_id}/vendor",
		"rm -rfv _build/upload/src/addons/{addon_id}/_driver",
		"rm -rfv _build/upload/src/addons/{addon_id}/Seed",
		"rm -rfv _build/upload/src/addons/{addon_id}/.phpunit.cache _build/upload/src/addons/{addon_id}/.phpunit.result.cache",
		"rm -fv _build/upload/src/addons/{addon_id}/TESTING.md _build/upload/src/addons/{addon_id}/CLAUDE.md _build/upload/src/addons/{addon_id}/CLAUDE.local.md",
		"mv -v _build/upload/src/addons/{addon_id}/*.md _build/"
