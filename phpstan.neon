includes:
    - vendor/hampel/xenforo-phpstan/extension.neon

parameters:
    level: 2

    # The add-on's PHP floor. PHPStan reports syntax newer than this, which the suite, running
    # on far newer PHP, cannot. It is why tests/ is not analysed: read as 7.4, PHPUnit 12 is
    # unreadable, and every assertion is reported as an undefined method.
    phpVersion: 70400

    paths:
        - .

    excludePaths:
        # Scanned through the Composer autoloader already; scanning the directory as well lets a
        # dependency's scaffold shadow the add-on's own classes of the same name.
        analyseAndScan:
            - vendor (?)
        # tests/ for the reason above; the rest is generated by XenForo, not the add-on's code.
        analyse:
            - tests
            - _output (?)
            - _releases (?)
            - _data (?)

    ignoreErrors:
        # XF\AddOn\AddOn answers any property through __get(), from the installed record or from
        # addon.json. Nothing declares them, and crates.neon does not list the class.
        -
            identifier: property.notFound
            message: '#^Access to an undefined property XF\\AddOn\\AddOn::\$(title|json_version_id|json_version_string)\.$#'
            path: Api/Controller/AddOns.php
            count: 3
        -
            identifier: property.notFound
            message: '#^Access to an undefined property XF\\AddOn\\AddOn::\$version_string\.$#'
            path: Cli/Command/Config.php
            count: 1
        # An option is a magic property. One read of one core option does not justify making every
        # XF\Options property a crate.
        -
            identifier: property.notFound
            message: '#^Access to an undefined property XF\\Options::\$onlineStatusTimeout\.$#'
            path: Repository/Online.php
            count: 1
